{
  "name": "anonymous-reporter",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-Trust Anonymous Reporting System — monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "lint:backend": "npm run lint -w backend",
    "test": "npm run test -w backend",
    "setup:keys": "npm run setup:keys -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "protobufjs": "8.7.2",
    "@grpc/grpc-js": "1.14.4",
    "elliptic": "6.6.1",
    "brace-expansion": "5.0.9",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "shell-quote": "1.10.0",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
