# Production compose environment — COPY TO .env AND FILL
# NEVER commit this file's real values.

# ── Network / service ──
NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=https://report.example.gov.am

# ── Hedera (testnet now; mainnet after Phase D checklist) ──
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.1234567
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_TOPIC_ID=0.0.1234568

# ── Admin / ops ──
# Generate: openssl rand -hex 32
OPERATOR_API_KEY=

# ── Internal network bridge (Phase C) ──
# Leave empty only if ENABLE_INTERNAL_MOCK=1 in dev; in production set the URL.
INTERNAL_NETWORK_URL=https://internal-bridge.gov.internal/ingest
ENABLE_INTERNAL_MOCK=0

# ⚠️ LE_PRIVATE_KEY_PEM is NOT set here on purpose — the blind proxy must
# never hold the decryption key. It lives only on the internal-network host.

# ── MinIO ──
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=anonymous_reporter
MINIO_ROOT_PASSWORD=            # openssl rand -base64 24
MINIO_BUCKET=reports

# ── Frontend ──
NEXT_PUBLIC_API_URL=https://api.report.example.gov.am

# ── SimpleX ──
SMP_PORT=5223
SMP_ADDR=smp.example.gov.am
