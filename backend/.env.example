PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Hedera network: testnet | mainnet (mainnet ONLY after Phase D checklist)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.1234567
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_TOPIC_ID=0.0.1234568
# Admin stats API key (required in production — NODE_ENV=production fails closed)
# Generate with: openssl rand -hex 32
OPERATOR_API_KEY=
# Internal (air-gapped) network bridge. Leave empty for dev mock forwarding.
# NEVER put the LE private key on this (blind) proxy — the key lives only on
# the internal-network host.
INTERNAL_NETWORK_URL=
ENABLE_INTERNAL_MOCK=1
# MinIO S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=anonymous_reporter
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=reports
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# ⚠️ Law Enforcement decryption key — INTERNAL NETWORK ONLY.
# NOT for the blind proxy. Generated by: npm run setup:keys
LE_PRIVATE_KEY_PEM="[REDACTED PRIVATE KEY]"
